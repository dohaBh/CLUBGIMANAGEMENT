{# {% extends 'base.html.twig' %}

{% block title %}Club GI - Accueil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            overflow-x: hidden;
        }

        /* Navbar Premium */
        .navbar-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            padding: 1.2rem 0;
            box-shadow: 0 4px 30px rgba(0,0,0,0.05);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            transition: all 0.3s ease;
        }

        .navbar-custom.scrolled {
            padding: 0.8rem 0;
            box-shadow: 0 4px 30px rgba(0,0,0,0.1);
        }

        .navbar-brand {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
        }

        .nav-link-custom {
            color: #d4af37 !important;
            font-weight: 600;
            padding: 0.6rem 1.5rem !important;
            margin: 0 0.3rem;
            border-radius: 30px;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .nav-link-custom:hover {
            background: rgba(212,175,55,0.1);
            transform: translateY(-2px);
        }

        .btn-nav {
            padding: 0.7rem 1.8rem;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            font-size: 0.95rem;
        }

        .btn-nav-primary {
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            color: #fff !important;
            box-shadow: 0 4px 15px rgba(212,175,55,0.3);
        }

        .btn-nav-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(212,175,55,0.4);
        }

        .btn-nav-secondary {
            border: 2px solid #d4af37;
            color: #d4af37 !important;
            background: transparent;
        }

        .btn-nav-secondary:hover {
            background: #d4af37;
            color: #fff !important;
            transform: translateY(-2px);
        }

        /* Hero Section - Gift Box */
        .hero-wrapper {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #3d5fa8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 50px;
            position: relative;
            overflow: hidden;
        }

        /* Animated Background Particles */
        .particle {
            position: absolute;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            animation: float 15s infinite ease-in-out;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
            50% { transform: translateY(-100px) translateX(50px); opacity: 0.6; }
        }

        .gift-container {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .gift-box {
            position: relative;
            width: 300px;
            height: 300px;
            margin: 0 auto 3rem;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .gift-box:hover {
            transform: scale(1.05);
        }

        .box-body {
            width: 280px;
            height: 280px;
            background: linear-gradient(145deg, #d4af37, #f4d03f);
            border-radius: 20px;
            position: relative;
            box-shadow: 0 20px 60px rgba(212,175,55,0.4);
        }

        .box-ribbon-v {
            width: 60px;
            height: 280px;
            background: linear-gradient(to right, #b8941f, #d4af37);
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
        }

        .box-ribbon-h {
            width: 280px;
            height: 60px;
            background: linear-gradient(to bottom, #b8941f, #d4af37);
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
        }

        .box-lid {
            width: 300px;
            height: 40px;
            background: linear-gradient(145deg, #f4d03f, #d4af37);
            position: absolute;
            top: -15px;
            left: -10px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(212,175,55,0.5);
        }

        .bow {
            width: 80px;
            height: 80px;
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%);
        }

        .bow::before,
        .bow::after {
            content: '';
            position: absolute;
            width: 40px;
            height: 50px;
            background: linear-gradient(145deg, #f4d03f, #d4af37);
            border-radius: 50% 50% 0 0;
            box-shadow: 0 5px 20px rgba(212,175,55,0.4);
        }

        .bow::before {
            left: 0;
            transform: rotate(-20deg);
        }

        .bow::after {
            right: 0;
            transform: rotate(20deg);
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 1rem;
            text-shadow: 0 4px 20px rgba(0,0,0,0.2);
            letter-spacing: -1px;
        }

        .hero-subtitle {
            font-size: 1.4rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-20px); }
        }

        .scroll-indicator i {
            color: #d4af37;
            font-size: 2rem;
        }

        /* Bubbles Section */
        .bubbles-section {
            background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
            padding: 6rem 0 8rem;
            position: relative;
            overflow: visible;
        }

        .section-header {
            text-align: center;
            margin-bottom: 5rem;
        }

        .section-title {
            font-size: 3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
            color: #6c757d;
            max-width: 700px;
            margin: 0 auto;
        }

        /* Bubble Cards */
        .bubbles-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 4rem 3rem;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 3rem;
        }

        .bubble-card {
            background: #fff;
            border-radius: 30px;
            padding: 3rem 2.5rem;
            text-align: center;
            position: relative;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            border: 2px solid transparent;
            animation: floatUp 6s ease-in-out infinite;
        }

        .bubble-card:nth-child(1) { animation-delay: 0s; }
        .bubble-card:nth-child(2) { animation-delay: 1.5s; }
        .bubble-card:nth-child(3) { animation-delay: 3s; }
        .bubble-card:nth-child(4) { animation-delay: 4.5s; }

        @keyframes floatUp {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .bubble-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 60px rgba(212,175,55,0.3);
            border-color: #d4af37;
            animation: none;
        }

        .bubble-icon {
            width: 110px;
            height: 110px;
            margin: 0 auto 2rem;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(212,175,55,0.3);
            position: relative;
            transition: all 0.3s ease;
        }

        .bubble-card:hover .bubble-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .bubble-icon::before {
            content: '';
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            border: 3px solid rgba(212,175,55,0.2);
            border-radius: 50%;
            animation: pulse 3s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }

        .bubble-icon i {
            font-size: 3rem;
            color: #fff;
        }

        .bubble-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1e3c72;
            margin-bottom: 1.2rem;
        }

        .bubble-description {
            font-size: 1.1rem;
            color: #6c757d;
            line-height: 1.9;
            margin-bottom: 1.5rem;
        }

        .bubble-stats {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 1rem;
        }

        .stat-badge {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #1e3c72;
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            padding: 5rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .cta-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
            opacity: 0.3;
        }

        .cta-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }

        .cta-title {
            font-size: 2.8rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 1.5rem;
        }

        .cta-text {
            font-size: 1.3rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 3rem;
            line-height: 1.8;
        }

        .cta-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-cta {
            padding: 1rem 2.5rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-cta-primary {
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            color: #1e3c72;
            box-shadow: 0 10px 30px rgba(212,175,55,0.4);
        }

        .btn-cta-primary:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(212,175,55,0.5);
            color: #1e3c72;
        }

        .btn-cta-secondary {
            background: transparent;
            border: 3px solid #fff;
            color: #fff;
        }

        .btn-cta-secondary:hover {
            background: #fff;
            color: #1e3c72;
            transform: translateY(-5px);
        }

        /* Footer */
        .footer-custom {
            background: #1a1a2e;
            color: #fff;
            padding: 4rem 2rem 2rem;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-section {
            margin-bottom: 2rem;
        }

        .footer-title {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1rem;
        }

        .footer-text {
            color: rgba(255,255,255,0.7);
            line-height: 1.8;
            font-size: 1.05rem;
        }

        .footer-link {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: all 0.3s ease;
            display: block;
            margin-bottom: 0.5rem;
        }

        .footer-link:hover {
            color: #d4af37;
            padding-left: 5px;
        }

        .social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .social-link {
            width: 45px;
            height: 45px;
            background: rgba(212,175,55,0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d4af37;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .social-link:hover {
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            color: #fff;
            transform: translateY(-3px);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 2rem;
            margin-top: 2rem;
            text-align: center;
            color: rgba(255,255,255,0.5);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero-title { font-size: 2.5rem; }
            .section-title { font-size: 2rem; }
            .gift-box { width: 200px; height: 200px; }
            .box-body { width: 180px; height: 180px; }
            .bubbles-container { 
                grid-template-columns: 1fr;
                gap: 3rem;
                padding: 0 1.5rem;
            }
            .cta-buttons { flex-direction: column; }
        }

        @media (min-width: 769px) and (max-width: 1024px) {
            .bubbles-container {
                grid-template-columns: repeat(2, 1fr);
                gap: 3rem 2rem;
            }
        }

        @media (min-width: 1400px) {
            .bubbles-container {
                grid-template-columns: repeat(2, 1fr);
                gap: 5rem 4rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container">
        <a class="navbar-brand" href="#">🎓 Club GI</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">
                <li class="nav-item">
                    <a class="nav-link-custom btn-nav-secondary btn-nav" href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right"></i> Connexion
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link-custom btn-nav-primary btn-nav" href="{{ path('app_register') }}">
                        <i class="bi bi-person-plus"></i> S'inscrire
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section - Gift Box -->
<section class="hero-wrapper">
    <!-- Animated Particles -->
    <div class="particle" style="width: 10px; height: 10px; top: 10%; left: 10%;"></div>
    <div class="particle" style="width: 15px; height: 15px; top: 20%; left: 80%;"></div>
    <div class="particle" style="width: 8px; height: 8px; top: 60%; left: 15%;"></div>
    <div class="particle" style="width: 12px; height: 12px; top: 70%; left: 85%;"></div>
    <div class="particle" style="width: 20px; height: 20px; top: 30%; left: 50%;"></div>

    <div class="gift-container">
        <div class="gift-box">
            <div class="box-lid"></div>
            <div class="bow"></div>
            <div class="box-body">
                <div class="box-ribbon-v"></div>
                <div class="box-ribbon-h"></div>
            </div>
        </div>
        
        <h1 class="hero-title">Bienvenue au Club GI</h1>
        <p class="hero-subtitle">
            Découvrez une communauté dynamique d'étudiants passionnés par l'innovation technologique 
            et l'excellence en génie informatique.
        </p>
    </div>

    <div class="scroll-indicator">
        <i class="bi bi-chevron-down"></i>
    </div>
</section>

<!-- Bubbles Section -->
<section class="bubbles-section">
    <div class="section-header">
        <h2 class="section-title">Ce que nous offrons</h2>
        <p class="section-subtitle">
            Des opportunités uniques pour développer vos compétences et élargir votre réseau
        </p>
    </div>

    <div class="bubbles-container">
        <!-- Events Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-calendar-event"></i>
            </div>
            <h3 class="bubble-title">Événements</h3>
            <p class="bubble-description">
                Hackathons, conférences tech, rencontres avec des professionnels et soirées networking organisés tout au long de l'année.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">50+ par an</span>
            </div>
        </div>

        <!-- Members Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-people"></i>
            </div>
            <h3 class="bubble-title">Membres</h3>
            <p class="bubble-description">
                Rejoignez une communauté de 500+ étudiants motivés, partagez vos idées et créez des connexions durables.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">500+ membres</span>
            </div>
        </div>

        <!-- Formations Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-laptop"></i>
            </div>
            <h3 class="bubble-title">Formations</h3>
            <p class="bubble-description">
                Ateliers pratiques sur IA, développement web/mobile, cybersécurité, cloud computing et les dernières technologies.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">30+ ateliers</span>
            </div>
        </div>

        <!-- Projects Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-code-slash"></i>
            </div>
            <h3 class="bubble-title">Projets</h3>
            <p class="bubble-description">
                Travaillez sur des projets réels, développez votre portfolio et gagnez une expérience concrète valorisée par les recruteurs.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">40+ projets</span>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="cta-content">
        <h2 class="cta-title">Prêt à commencer votre aventure ?</h2>
        <p class="cta-text">
            Rejoignez le Club GI dès aujourd'hui et faites partie d'une communauté qui façonne 
            l'avenir de la technologie au Maroc.
        </p>
        <div class="cta-buttons">
            <a href="{{ path('app_register') }}" class="btn-cta btn-cta-primary">
                <i class="bi bi-rocket-takeoff"></i>
                Rejoindre le club
            </a>
            <a href="{{ path('app_login') }}" class="btn-cta btn-cta-secondary">
                <i class="bi bi-box-arrow-in-right"></i>
                Se connecter
            </a>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="footer-custom">
    <div class="footer-content">
        <div class="row">
            <div class="col-md-4 footer-section">
                <h5 class="footer-title">Club GI - ENSAO</h5>
                <p class="footer-text">
                    Le club des étudiants en Génie Informatique à l'École Nationale des Sciences Appliquées d'Oujda.
                    Innovation, Excellence, Collaboration.
                </p>
                <div class="social-links">
                    <a href="#" class="social-link"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-link"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-link"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="social-link"><i class="bi bi-github"></i></a>
                </div>
            </div>
            
            <div class="col-md-4 footer-section">
                <h5 class="footer-title">Liens Rapides</h5>
                <a href="{{ path('app_register') }}" class="footer-link">S'inscrire</a>
                <a href="{{ path('app_login') }}" class="footer-link">Se connecter</a>
                <a href="#" class="footer-link">Événements</a>
                <a href="#" class="footer-link">Projets</a>
            </div>
            
            <div class="col-md-4 footer-section">
                <h5 class="footer-title">Contact</h5>
                <p class="footer-text">
                    <i class="bi bi-envelope footer-icon"></i> contact@clubgi.ma<br>
                    <i class="bi bi-telephone footer-icon"></i> +212 6XX XXX XXX<br>
                    <i class="bi bi-geo-alt footer-icon"></i> ENSAO, Complexe Universitaire<br>
                    Oujda 60000, Maroc
                </p>
            </div>
        </div>
        
        <div class="footer-bottom">
            <p>&copy; 2024 Club GI - ENSAO. Tous droits réservés. Développé avec 💛 par les membres du club.</p>
        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Navbar scroll effect
    window.addEventListener('scroll', function() {
        const navbar = document.querySelector('.navbar-custom');
        if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });

    // Smooth scroll
    document.querySelector('.scroll-indicator').addEventListener('click', function() {
        document.querySelector('.bubbles-section').scrollIntoView({ behavior: 'smooth' });
    });
</script>
{% endblock %} #}














































{# {% extends 'base.html.twig' %}

{% block title %}Club GI - Accueil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
