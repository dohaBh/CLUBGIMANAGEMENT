{% extends 'baseDash.html.twig' %}

{% block title %}Modifier Formation - {{ formation.titre }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Modifier la formation
                    </h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.titre) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.module) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(form.description) }}
                    </div>
                    
                    {# Formateurs seulement #}
                    <div class="mb-3">
                        {{ form_row(form.formateurs) }}
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            {{ form_row(form.date) }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ form_row(form.lieu) }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ form_row(form.nbParticipants) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(form.statutFormation) }}
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_formations_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-1"></i> Enregistrer
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}