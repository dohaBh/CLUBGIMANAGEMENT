{% extends 'baseDash.html.twig' %}

{% block title %}Formations en attente d'approbation{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 mb-0">
                <i class="fas fa-clock me-2"></i>
                Formations en attente d'approbation
            </h1>
            <p class="text-muted">Approuvez ou rejetez les formations soumises par les utilisateurs.</p>

        </div>
    </div>

    <div class="row g-4">
        {% for formation in formations %}
        <div class="col-md-6">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">{{ formation.titre }}</h5>
                        <span class="badge bg-dark">
                            <i class="fas fa-user me-1"></i>
                            {{ formation.createdBy.prenom }} {{ formation.createdBy.nom }}
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <p><strong>Module:</strong> {{ formation.module }}</p>
                    <p><strong>Description:</strong> {{ formation.description|slice(0, 150) }}...</p>
                    <p><strong>Date:</strong> {{ formation.date|date('d/m/Y') }}</p>
                    <p><strong>Lieu:</strong> {{ formation.lieu }}</p>
                    
                    {% if formation.formateurs|length > 0 %}
                    <p><strong>Formateurs:</strong>
                        {% for formateur in formation.formateurs %}
                            <span class="badge bg-info">{{ formateur.prenom }} {{ formateur.nom }}</span>
                        {% endfor %}
                    </p>
                    {% endif %}
                    
                    <p><strong>Créée le:</strong> {{ formation.createdAt|date('d/m/Y H:i') }}</p>
                    
                    <div class="mt-3">
                        <form method="post" action="{{ path('app_formations_approve', {'id': formation.id}) }}" 
                              class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ formation.id) }}">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check me-1"></i> Approuver
                            </button>
                        </form>
                        
                        <form method="post" action="{{ path('app_formations_reject', {'id': formation.id}) }}" 
                              class="d-inline" 
                              onsubmit="return confirm('Êtes-vous sûr de vouloir rejeter cette formation ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ formation.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-times me-1"></i> Rejeter
                            </button>
                        </form>
                        
                        <a href="{{ path('app_formations_index') }}" class="btn btn-outline-warning">
                            <i class="fas fa-edit me-1"></i> Modifier
                        </a>

                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>
                Aucune formation en attente d'approbation.
            </div>
        </div>
        {% endfor %}
    </div>
	<a href="{{ path('app_formations_index') }}" class="btn btn-outline-warning">
        <i class="fas fa-edit me-1"></i>retour
    </a>
</div>
{% endblock %}