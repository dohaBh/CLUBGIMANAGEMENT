{% extends 'base.html.twig' %}

{% block title %}Club GI - Accueil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }

        /* Navbar personnalisée */
        .navbar-custom {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 700;
            margin-left: 10%;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .navbar-nav {
            margin-right: 10%;
        }

        .nav-link-custom {
            color: #d4af37 !important;
            font-weight: 600;
            padding: 0.5rem 1.2rem !important;
            margin: 0 0.3rem;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

        .nav-link-custom:hover {
            background: rgba(212,175,55,0.1);
            transform: translateY(-2px);
        }

        .btn-nav-primary {
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            color: #fff !important;
            font-weight: 600;
            border: none;
        }

        .btn-nav-primary:hover {
            background: linear-gradient(135deg, #f4d03f 0%, #d4af37 100%);
            box-shadow: 0 5px 15px rgba(212,175,55,0.4);
            color: #fff !important;
        }

        .btn-nav-secondary {
            border: 2px solid #d4af37;
            color: #d4af37 !important;
            font-weight: 600;
            background: transparent;
        }

        .btn-nav-secondary:hover {
            background: #d4af37;
            color: #fff !important;
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #3d5fa8 100%);
            min-height: 90vh;
            display: flex;
            align-items: center;
            padding: 4rem 0;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
            opacity: 0.3;
        }

        .hero-content {
            color: white;
            position: relative;
            z-index: 1;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, #fff 0%, #d4af37 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-size: 1.3rem;
            line-height: 1.8;
            color: #e8eaf6;
            margin-bottom: 2rem;
        }

        .btn-hero {
            padding: 15px 40px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-hero-primary {
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            color: #1e3c72;
        }

        .btn-hero-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(212,175,55,0.4);
        }

        .btn-hero-secondary {
            background: transparent;
            border: 2px solid #fff;
            color: #fff;
        }

        .btn-hero-secondary:hover {
            background: #fff;
            color: #1e3c72;
            transform: translateY(-3px);
        }

        .hero-image {
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            transition: transform 0.3s ease;
        }

        .hero-image:hover {
            transform: scale(1.02);
        }

        /* Features Section */
        .features-section {
            padding: 6rem 0;
            background: #fff;
            position: relative;
        }

        .features-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 300px;
            background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
            z-index: 0;
        }

        .container {
            position: relative;
            z-index: 1;
        }

        .section-title {
            font-size: 2.8rem;
            font-weight: 700;
            color: #1e3c72;
            margin-bottom: 1rem;
            text-align: center;
        }

        .section-subtitle {
            font-size: 1.2rem;
            color: #6c757d;
            text-align: center;
            margin-bottom: 4rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .timeline-container {
            position: relative;
            max-width: 1000px;
            margin: 0 auto;
        }

        .timeline-item {
            display: flex;
            align-items: center;
            margin-bottom: 4rem;
            position: relative;
        }

        .timeline-item:nth-child(even) {
            flex-direction: row-reverse;
        }

        .timeline-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 10px 30px rgba(212,175,55,0.3);
            z-index: 2;
        }

        .timeline-icon i {
            color: #fff;
            font-size: 2.5rem;
        }

        .timeline-content {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            flex: 1;
            margin: 0 2rem;
            transition: all 0.4s ease;
            border: 2px solid transparent;
        }

        .timeline-content:hover {
            transform: scale(1.03);
            border-color: #d4af37;
            box-shadow: 0 15px 50px rgba(212,175,55,0.2);
        }

        .timeline-title {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1rem;
        }

        .timeline-text {
            color: #6c757d;
            line-height: 1.8;
            font-size: 1.05rem;
        }

        .stats-section {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            padding: 4rem 2rem;
            border-radius: 20px;
            margin-top: 5rem;
            box-shadow: 0 15px 50px rgba(30,60,114,0.3);
        }

        .stat-item {
            text-align: center;
            padding: 1rem;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: #e8eaf6;
            font-size: 1.1rem;
            font-weight: 500;
        }

        @media (max-width: 768px) {
            .timeline-item,
            .timeline-item:nth-child(even) {
                flex-direction: column;
            }

            .timeline-content {
                margin: 2rem 0 0 0;
            }
        }

        /* Footer */
        .footer-custom {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 3rem 0 1.5rem;
        }

        .footer-title {
            color: #d4af37;
            font-weight: 600;
            font-size: 1.3rem;
            margin-bottom: 1rem;
        }

        .footer-text {
            color: #e8eaf6;
            line-height: 1.8;
        }

        .footer-icon {
            color: #d4af37;
            margin-right: 0.5rem;
        }

        @media (max-width: 768px) {
            .navbar-brand {
                margin-left: 5%;
            }
            .navbar-nav {
                margin-right: 5%;
            }
            .hero-title {
                font-size: 2.5rem;
            }
        }
    </style>
{% endblock %}

