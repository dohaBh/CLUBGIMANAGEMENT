

{% extends 'base.html.twig' %}

{% block title %}Club GI - Accueil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">

{% endblock %}

{% block body %}
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container">
        <a class="navbar-brand" href="#">🎓 Club GI</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">
                <li class="nav-item">
                    <a class="nav-link-custom btn-nav-secondary btn-nav" href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right"></i> Connexion
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link-custom btn-nav-primary btn-nav" href="{{ path('app_register') }}">
                        <i class="bi bi-person-plus"></i> S'inscrire
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>



<!-- Bubbles Section -->
<section class="bubbles-section">
    <div class="section-header">
        <h2 class="section-title">Ce que nous offrons</h2>
        <p class="section-subtitle">
            Des opportunités uniques pour développer vos compétences et élargir votre réseau
        </p>
    </div>

    <div class="bubbles-container">
        <!-- Events Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-calendar-event"></i>
            </div>
            <h3 class="bubble-title">Événements</h3>
            <p class="bubble-description">
                Hackathons, conférences tech, rencontres avec des professionnels et soirées networking organisés tout au long de l'année.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">50+ par an</span>
            </div>
        </div>

        <!-- Members Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-people"></i>
            </div>
            <h3 class="bubble-title">Membres</h3>
            <p class="bubble-description">
                Rejoignez une communauté de 500+ étudiants motivés, partagez vos idées et créez des connexions durables.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">500+ membres</span>
            </div>
        </div>

        <!-- Formations Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-laptop"></i>
            </div>
            <h3 class="bubble-title">Formations</h3>
            <p class="bubble-description">
                Ateliers pratiques sur IA, développement web/mobile, cybersécurité, cloud computing et les dernières technologies.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">30+ ateliers</span>
            </div>
        </div>

        <!-- Projects Bubble -->
        <div class="bubble-card">
            <div class="bubble-icon">
                <i class="bi bi-code-slash"></i>
            </div>
            <h3 class="bubble-title">Projets</h3>
            <p class="bubble-description">
                Travaillez sur des projets réels, développez votre portfolio et gagnez une expérience concrète valorisée par les recruteurs.
            </p>
            <div class="bubble-stats">
                <span class="stat-badge">40+ projets</span>
            </div>
        </div>
    </div>
</section>

<!-- Hero Section - Gift Box -->
<section class="hero-wrapper">

    <div class="gift-container">
        <div class="image-wrapper">
            <div class="image-decoration"></div>
            <div class="glow-effect"></div>
            <div class="image-container">
                <img src="images/logos.png" 
                     alt="Club GI - Étudiants en technologie">
            </div>
        </div>
        
<section class="cta-section">
    <div class="cta-content">
        <h2 class="cta-title">Prêt à commencer votre aventure ?</h2>
        <p class="cta-text">
            Rejoignez le Club GI dès aujourd'hui et faites partie d'une communauté qui façonne 
            l'avenir de la technologie au Maroc.
        </p>
        <div class="cta-buttons">
            <a href="{{ path('app_register') }}" class="btn-cta btn-cta-primary">
                <i class="bi bi-rocket-takeoff"></i>
                Rejoindre le club
            </a>
            <a href="{{ path('app_login') }}" class="btn-cta btn-cta-secondary">
                <i class="bi bi-box-arrow-in-right"></i>
                Se connecter
            </a>
        </div>
    </div>
</section> 
    </div>

    <div class="scroll-indicator">
        <i class="bi bi-chevron-down"></i>
    </div>
</section>


<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Navbar scroll effect
    window.addEventListener('scroll', function() {
        const navbar = document.querySelector('.navbar-custom');
        if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });

    // Smooth scroll
    document.querySelector('.scroll-indicator').addEventListener('click', function() {
        document.querySelector('.bubbles-section').scrollIntoView({ behavior: 'smooth' });
    });
</script>
{% endblock %}